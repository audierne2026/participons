# ─────────────────────────────────────────────────────────────────────────
# .env.infra — audierne2026
# Concern: mail and the connectors to other services.
# Blast radius: server / service breach. Rotation: seasonal, or on exposure.
# Load with: source scripts/dev-env.sh
# ─────────────────────────────────────────────────────────────────────────

# App password of the contribution inbox (EMAIL_USER in .env.config)
EMAIL_PASS=<forseti - ok>

# participonsmobile — the mobile app's connector
PARTICIPONSMOBILE_CLIENT_ID=<forseti - ok>
PARTICIPONSMOBILE_CLIENT_SECRET=<forseti - ok>
