# ─────────────────────────────────────────────────────────────────────────
# .env.config — audierne2026
# Concern: settings and identifiers. CONFIG class only — no secret lives here.
# Blast radius: app restart. Rotation: never.
# Load with: source scripts/dev-env.sh
# ─────────────────────────────────────────────────────────────────────────

# The repository the scripts read (CI sets GITHUB_REPOSITORY itself)
GITHUB_REPOSITORY=audierne2026/participons

# Contribution inbox polled by scripts/poll_email.py (its password: .env.infra)
EMAIL_USER=<project mailbox address>
