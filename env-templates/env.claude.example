# GitHub PAT — project management on audierne2026/participons (Claude + scripts only).
# Identity: jnschilling. Consumed by scripts/export_contributions_to_md.py
# (issues/discussions → markdown for the RAG pipeline).
GITHUB_API=<forseti - ok>

# Ocapistaine bot token — write access to locki-io + audierne2026
# (issues, discussions, push to the `dev` branch only — never `main`).
# Identity: ocapistaine bot. Cross-repo RAG handoff to locki-io/ocapistaine.
OCAP_LOCKI_TOKEN=<forseti - ok>

